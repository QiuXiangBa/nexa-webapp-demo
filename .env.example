# mock: 使用本地 mock 数据；api: 走后端接口
VITE_API_MODE=mock

# API 模式下的服务端地址
VITE_API_BASE_URL=http://localhost:8092

# 业务动态图白名单域名，逗号分隔，支持 *.example.com
# 示例：VITE_BIZ_IMAGE_ALLOWED_HOSTS=img.nexa.com,cdn.nexa.com,*.oss-cn-hangzhou.aliyuncs.com
VITE_BIZ_IMAGE_ALLOWED_HOSTS=localhost,127.0.0.1

# 后端若返回图片 key（非绝对 URL），使用该地址拼接
# 示例：VITE_BIZ_IMAGE_CDN_BASE_URL=https://img.nexa.com/
VITE_BIZ_IMAGE_CDN_BASE_URL=

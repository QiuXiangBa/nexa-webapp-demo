{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:size": "node scripts/check-size-rules.mjs",
    "build": "npm run check:size && vue-tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:critical": "playwright test tests/e2e/critical-flow.spec.ts",
    "e2e:visual": "playwright test tests/e2e/ui-visual-baseline.spec.ts --config playwright.visual.config.ts",
    "e2e:visual:update": "playwright test tests/e2e/ui-visual-baseline.spec.ts --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "echarts": "^6.0.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "vant": "^4.9.22",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^2.2.0"
  }
}
